# =====================================================================
# Environment variables for the EmDash + Astro portfolio
# =====================================================================
#
# Copy this file to `.env` (local) or set these in the Vercel project's
# "Environment Variables" panel for production.

# --- Public site URL ---
# Used in metadata, OG tags, and the EmDash admin (auth callbacks).
# Locally: http://localhost:4321
# Vercel:  https://your-domain.com  (or leave unset to use VERCEL_URL)
SITE_URL=https://your-domain.com

# --- Database: Turso / libSQL (required on Vercel) ---
# Sign up free at https://turso.tech, create a database, then:
#   turso db show <name>            -> URL
#   turso db tokens create <name>   -> Auth token
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# --- Media storage: S3-compatible (required on Vercel) ---
# Cloudflare R2 is the recommended option (S3-compatible, free tier).
# Create an R2 bucket, an API token with Object Read/Write, and a public
# domain (R2 public bucket URL or a custom domain).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=portfolio-media
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL where the bucket is served (used to build <img> src in the CMS).
S3_PUBLIC_URL=https://pub-<id>.r2.dev
